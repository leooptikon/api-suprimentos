# Copie este arquivo para "backend/.env" e preencha. O .env NÃO vai para o git.

# Mercado Livre — dados da aplicação criada em https://developers.mercadolivre.com.br
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Tem que ser exatamente igual à "URI de redirect" cadastrada na aplicação
ML_REDIRECT_URI=
# Hora da atualização diária (horário de Brasília)
ML_HORARIO=07:00

# OneDrive — planilha Excel espelhando o estoque (aplicativo cadastrado em portal.azure.com → Microsoft Entra ID)
# "ID do aplicativo (cliente)" e "ID do diretório (locatário)" da página Visão geral do aplicativo
MS_CLIENT_ID=
MS_TENANT_ID=
# Nome do arquivo criado na pasta escolhida e de quanto em quanto tempo (segundos) o site confere se algo mudou
ONEDRIVE_ARQUIVO=Estoque Trace.xlsx
ONEDRIVE_INTERVALO=120
